# Variables d'environnement — modèle.
# Copier ce fichier en .env et le remplir, ou définir ces variables
# dans Vercel → Settings → Environment Variables.
#
# NE JAMAIS commiter un .env réel : il contient DATABASE_URL, qui donne
# un accès complet à la base.

# Connexion PostgreSQL à la base Neon du blog.
# Fournie par Neon → Connection Details. Valeur du rôle neondb_owner.
DATABASE_URL=

# Secret de signature des sessions d'administration.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Doit rester stable entre les déploiements, sinon les sessions sont invalides.
SESSION_SECRET=

# Adresse e-mail de l'administrateur unique autorisé à publier.
ADMIN_EMAIL=aideassociationetincelle@gmail.com